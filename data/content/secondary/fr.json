      "strategy": {
        "number": 1,
        "title": "Writing to your penfriend (task 7)",
        "parts": [
          {
            "text": "Not on the sheet — a plan for task 7. Write one or two sentences for each step:",
            "steps": [
              "Say hello and give your name.",
              "Say your age.",
              "Describe your personality — use très, assez or pas très.",
              "Say what you like and what you don't like.",
              "Join ideas with et, mais and aussi.",
              "Give an opinion: c'est génial, c'est nul."
            ]
          },
          {
            "heading": "Example",
            "text": "Salut ! Je m'appelle Sam. J'ai onze ans. Je suis assez bavard mais je ne suis pas très timide. J'aime la musique et j'aime aussi le sport. Je n'aime pas les serpents. À bientôt !",
            "words": [
              "Je m'appelle Sam.",
              "J'ai onze ans.",
              "Je suis assez bavard.",
              "J'aime aussi le sport.",
              "Je n'aime pas les serpents."
            ]
          },
          {
            "heading": "Girls and boys",
            "text": "Many adjectives add -e for a girl: il est grand, elle est grande. Words that already end in -e stay the same: timide, sympa.",
            "words": [
              "Il est grand.",
              "Elle est grande.",
              "Elle est timide."
            ]
          }
        ]
      },
